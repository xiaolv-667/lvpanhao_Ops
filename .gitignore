# ============================================================
# lvpanhao_Ops 只提交「代码 + 脚本 + 文档 + 环境配方」。
# 环境本体、模型/数据集、编译与 profiling 产物一律不入库，
# 由 README 中的脚本在目标机器上重建。
# ============================================================

# ---- Python 环境（按机器重建，见 README） ----
/venv-ascend950/
/venv*/
*.egg-info/

# ---- 数据与模型（约 6.3T，留在本机或对象存储，见 assets.md） ----
/shared_assets/

# ---- 本地缓存 / 临时目录 ----
/.cache/
/.tmpdelta/
/.shims-a5/
/.shims-py/
/.atomcode/artifacts/
/.atomcode/local/
/extra-info/
**/extra-info/

# ---- 密钥：绝不入库 ----
.deepseek.key
.env
.env.*

# ---- 编译 / profiling / 运行产物 ----
kernel_meta/
build/
dist/
**/reports/
# 例外：950PR 迁移的真机报告（run.json / 报告 md / 汇总 csv）要入库
!tilelang-mlir-ascend-950/examples/TileOPs/reports/
# 但 msprof 原始 trace 一律不入库（artifacts/ 下 .bin/.o/大 csv，单文件可达 300MB，
# 超过 GitHub 单文件 100MB 硬上限）
**/reports/**/artifacts/

# msprof 原始采集工作区（2.3 GB，含 .bin/.o 与数百 MB csv）不入库；
# 其结论已汇总进 examples/batch2/*.json 与 examples/TileOPs/profile_run_msprof_*.json
**/msprof_capture/

# perf_opt 的 profiling 原始数据（每轮 100+ MB，单文件最大 80 MB）。
# 优化结论本体（opt_log.md / perf_records.jsonl / 调优后 kernel / harness）照常入库。
**/perf_opt/profiles/

# ---- 调优 / benchmark 临时工作区（可再生成，不入库） ----
# mla_bwd_opt/inputs 约 31G、mla_dense_bwd_opt/inputs 约 5.6G，均为实测输入张量
**/*_opt/inputs/
**/*_opt/profiles/
# benchmark 一次性工作区（目录名带随机后缀）
/bench_one_*/
/rowstore_*/
/rope_bench_*/

# ---- msprof 原始采集 / 编译临时目录 ----
# v4_prof 含两份 229MB 的 visualize_data.bin，超过 GitHub 100MB 单文件硬上限
/v4_prof/
/tmp*/
/tl_kernel-*/

# ---- agent 本地状态（会话产出，非项目内容） ----
/.atomcode/

# ---- 本机 SSH 说明（只用于配推送，不进公开仓库） ----
SSH-PUBLIC-KEY.md

# ---- Python / pytest / 静态检查缓存 ----
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- 杂项 ----
*.log
.DS_Store
